---
import { todosLosPersonajes } from '@/lib/orden';
import Base from '@/layouts/Base.astro';
import Glifo from '@/components/Glifo.astro';
import Spoiler from '@/components/Spoiler.astro';
import { armas, escuadronDe } from '@/lib/armas';
import { nivelDeCapitulo } from '@/lib/spoilers';
import { ruta, REINO_NOMBRE } from '@/lib/rutas';
import { VINETAS } from '@/lib/vinetas';

export async function getStaticPaths() {
  const todos = await todosLosPersonajes();
  return todos.map((p) => ({ params: { id: p.id }, props: { p } }));
}
const { p } = Astro.props;
const a = armas(p);
const e = escuadronDe(p);
const req = nivelDeCapitulo(p.data.debut);
const sellado = req > 0;
const titulo = sellado ? 'Personaje lacrado, Black Clover' : `${p.data.nombre}, personaje de Black Clover`;
const descripcion = sellado ? 'Ficha con spoilers de Black Clover. Se abre según tu nivel.' : `Magia, grimorio, afiliación e historia de ${p.data.nombre} en Black Clover, con los spoilers tapados según tu nivel.`;
const companeros = e ? (await todosLosPersonajes()).filter((o) => o.data.escuadron?.id === e.id && o.id !== p.id).slice(0, 8) : [];
const revelaciones = [...p.data.revelaciones].sort((x, y) => x.capitulo - y.capitulo);
---
<Base titulo={titulo} descripcion={descripcion} ocultarDeBuscadores={sellado}>
  <div class="pagina">
    <div class="wrap">
      <p class="volver"><a class="link" href={ruta('personajes/')}>Volver a todos los personajes</a></p>
      <Spoiler nivel={req} sobre="este personaje" clase="ficha-sellada">
        <article class="ficha">
          <div class="ficha__escudo marco" style={`--c:${a.color}`}>
            <img class="ficha__vineta" src={ruta(`vinetas/${p.id}.svg`)} alt={`Escudo de ${p.data.nombre}: ${VINETAS[p.id].texto}`} width="200" height="240" />
            <span class="ficha__magia" aria-hidden="true"><Glifo tipo={p.data.glifo} /></span>
          </div>
          <div class="ficha__texto">
            <h1>{p.data.nombre}</h1>
            <p class="lead">{p.data.texto}</p>
            <dl class="ficha__datos">
              <div><dt>Magia</dt><dd>{p.data.magia}</dd></div>
              <div><dt>Grimorio</dt><dd>{p.data.grimorio}</dd></div>
              <div><dt>Afiliación</dt><dd>{e ? <a class="link" href={`${ruta('escuadrones/')}#${e.id}`}>{e.data.nombre}</a> : a.afiliacion}</dd></div>
              <div><dt>Rol</dt><dd>{p.data.rol}</dd></div>
              <div><dt>Reino</dt><dd>{REINO_NOMBRE[p.data.reino]}</dd></div>
            </dl>
            {revelaciones.length > 0 && (
              <section class="ficha__mas">
                <h2>Lo que pasa después</h2>
                <ol>
                  {revelaciones.map((r, i) => (
                    <li>
                      <Spoiler capitulo={r.capitulo} sobre={`lo que pasa después con este personaje, parte ${i + 1}`}><p>{r.texto} <span class="muted">{['Temporada 1.', 'Temporada 2.', 'Manga.'][nivelDeCapitulo(r.capitulo)]}</span></p></Spoiler>
                    </li>
                  ))}
                </ol>
              </section>
            )}
          </div>
        </article>
      </Spoiler>

      {companeros.length > 0 && !sellado && (
        <section class="companeros">
          <h2>También en {e!.data.nombre}</h2>
          <ul>{companeros.filter((c) => nivelDeCapitulo(c.data.debut) === 0).map((c) => <li><a class="link" href={ruta(`personajes/${c.id}/`)}>{c.data.nombre}</a></li>)}</ul>
        </section>
      )}
    </div>
  </div>
</Base>

<style>
  .volver { padding-bottom: 28px; }
  .volver a { --u: 8px; display: inline-block; padding: 8px 0; }
  .ficha { display: grid; grid-template-columns: 410px minmax(0, 1fr); gap: 48px 72px; align-items: start; padding-bottom: 64px; }
  .ficha__escudo { position: relative; display: grid; place-items: center; aspect-ratio: 1 / 1.120; background-image: radial-gradient(ellipse at 50% 50%, color-mix(in oklab, var(--c) 70%, transparent), transparent 74%); }
  .ficha__escudo::before { content: ''; position: absolute; inset: 4px; background: repeating-radial-gradient(circle at 50% 50%, transparent 0 9px, color-mix(in oklab, var(--oro) 36%, transparent) 9px 10px); mask: radial-gradient(circle, #000 25%, transparent 72%); -webkit-mask: radial-gradient(circle, #000 25%, transparent 72%); }
  .ficha__vineta { position: relative; width: 74%; height: auto; filter: drop-shadow(0 14px 18px rgb(0 0 0 / 0.5)); }
  .ficha__magia { position: absolute; right: 20px; bottom: 20px; display: grid; place-items: center; width: 84px; height: 84px; border-radius: 50%; border: 2px solid var(--oro); background: var(--bg); color: var(--oro); }
  .ficha__magia :global(.glifo) { width: 46px; height: 46px; stroke-width: 1.400; }
  .ficha h1 { font-size: clamp(44px, 1.600rem + 3vw, 72px); margin-bottom: 18px; }
  .ficha .lead { max-width: 58ch; }
  .ficha__datos { display: grid; grid-template-columns: 1fr 1fr; column-gap: 24px; margin-top: 32px; border-top: 2px solid var(--line-strong); }
  .ficha__datos > div { padding: 10px 0; border-bottom: 1px solid var(--linea); }
  .ficha__datos > div:last-child:nth-child(odd) { grid-column: 1 / -1; }
  .ficha__datos dt { color: var(--muted); font-size: 16px; }
  .ficha__datos dd { font-weight: 600; }
  .ficha__mas { margin-top: 48px; }
  .ficha__mas h2 { font-size: var(--t-h3); margin-bottom: 14px; }
  .ficha__mas li { padding: 14px 0; border-top: 1px solid var(--linea); max-width: 66ch; }
  .companeros { border-top: 2px solid var(--line-strong); padding: 28px 0 96px; }
  .companeros h2 { font-size: var(--t-h3); margin-bottom: 8px; }
  .companeros ul { display: flex; flex-wrap: wrap; gap: 4px 28px; }
  .companeros a { --u: 8px; display: inline-block; padding: 8px 0; }
  :global(.ficha-sellada) { margin-bottom: 96px; }
  @media (max-width: 1023px) { .ficha { grid-template-columns: 1fr; } .ficha__escudo { aspect-ratio: auto; padding: 32px; } .ficha__vineta { width: 210px; } }
  @media (max-width: 479px) { .ficha__datos { grid-template-columns: 1fr; } }
</style>
