---
import { todosLosPersonajes } from '@/lib/orden';
import Base from '@/layouts/Base.astro';
import Glifo from '@/components/Glifo.astro';
import Grimorio from '@/components/Grimorio.astro';
import Escudo from '@/components/Escudo.astro';
import Spoiler from '@/components/Spoiler.astro';
import mundo from '@/data/mundo.json';
import { REINO_ARMAS, ruta } from '@/lib/rutas';
import { nivelDeCapitulo } from '@/lib/spoilers';

const demonios = (await todosLosPersonajes()).filter((p) => p.data.reino === 'inframundo');
---
<Base titulo="Magia y mundo de Black Clover: grimorios, reinos y demonios" descripcion="Cómo funciona la magia en Black Clover, qué significa cada grimorio, cómo son los reinos Clover, Spade, Heart y Diamond y quiénes son los demonios.">
  <div class="pagina">
    <div class="wrap">
      <header class="pagina__cabeza">
        <h1>Magia y mundo</h1>
        <p class="lead">Grimorios, atributos, reinos y lo que hay debajo. Los términos que aparecen más tarde en la historia van tapados.</p>
      </header>
      <div class="pagina__cuerpo">
        <section class="bloque">
          <h2>Grimorios</h2>
          <p>El libro elige a su dueño y guarda sus hechizos. En Clover la cantidad de hojas del trébol dice mucho; los otros reinos usan su propio símbolo en la tapa.</p>
          <ul class="grimorios">
            {mundo.grimorios.map((g) => (
              <li><Grimorio hojas={g.hojas as 3 | 4 | 5} semilla={g.hojas} /><h3>{g.nombre}</h3><p>{g.texto}</p></li>
            ))}
          </ul>
        </section>

        <section class="bloque">
          <h2>Tipos de magia</h2>
          <p>Cada persona nace con un atributo, y de ahí salen variantes muy personales. Estas son las familias que conviene reconocer.</p>
          <dl class="familias">
            {mundo.magias.map((m) => (<div><dt><Glifo tipo={m.glifo} />{m.nombre}</dt><dd>{m.texto}</dd></div>))}
          </dl>
        </section>

        <section class="bloque">
          <h2>Reinos</h2>
          <p>Cuatro países comparten frontera y cada uno lleva un palo de la baraja.</p>
          <ul class="reinos">
            {mundo.reinos.map((r) => (
              <li>
                <Spoiler capitulo={r.capitulo} sobre="otro país">
                  <div class="reino"><Escudo color={REINO_ARMAS[r.id].color} trama={REINO_ARMAS[r.id].trama} emblema={r.palo} /><div><h3>{r.nombre}</h3><p>{r.texto}</p></div></div>
                </Spoiler>
              </li>
            ))}
          </ul>
        </section>

        <section class="bloque">
          <h2>Conceptos para no perderse</h2>
          <dl class="conceptos">
            {mundo.conceptos.map((c) => {
              const tapado = nivelDeCapitulo(c.capitulo) > 0;
              return tapado
                ? <div class="concepto--tapado"><dt class="sr">Concepto de más adelante</dt><dd><Spoiler capitulo={c.capitulo} sobre="un concepto"><strong class="termino">{c.nombre}</strong><p>{c.texto}</p></Spoiler></dd></div>
                : <div><dt class="termino">{c.nombre}</dt><dd>{c.texto}</dd></div>;
            })}
          </dl>
        </section>

        <section class="bloque">
          <h2>Demonios e inframundo</h2>
          <p>Otro mundo, con sus propias reglas y un odio viejo por los humanos. El final de la T1 abre esa puerta.</p>
          <div class="inframundo">
            <dl>
              {mundo.inframundo.map((i) => <div><dt class="termino">{i.nombre}</dt><dd>{i.texto}</dd></div>)}
            </dl>
            <ul class="demonios">
              {demonios.map((d) => (
                <li>
                  <Spoiler capitulo={d.data.debut} sobre="un demonio">
                    <a class="demonio" href={ruta(`personajes/${d.id}/`)}><Glifo tipo={d.data.glifo} /><span><strong>{d.data.nombre}</strong><span class="muted">{d.data.magia}. {d.data.afiliacion}.</span></span></a>
                  </Spoiler>
                </li>
              ))}
            </ul>
          </div>
        </section>
      </div>
    </div>
  </div>
</Base>

<style>
  .grimorios { display: grid; grid-template-columns: repeat(3, 1fr); gap: 48px 24px; }
  .grimorios :global(.grimorio) { height: 330px; width: auto; margin-bottom: 26px; filter: drop-shadow(0 16px 20px rgb(0 0 0 / 0.5)); }
  .grimorios p { margin-top: 8px; max-width: 40ch; }
  .familias { display: grid; grid-template-columns: 1fr 1fr; column-gap: 24px; border-top: 2px solid var(--line-strong); }
  .familias > div { display: grid; grid-template-columns: 1fr; align-content: start; gap: 6px; padding: 20px 24px 22px 0; border-bottom: 1px solid var(--linea); }
  .familias dt { display: flex; align-items: center; gap: 14px; font-family: var(--f-titulo); font-size: 27px; line-height: 1.1; }
  .familias :global(.glifo) { width: 34px; height: 34px; color: var(--trebol); }
  .familias dd { max-width: 54ch; padding-left: 48px; }
  .reinos li { border-top: 1px solid var(--linea); }
  .reino { display: grid; grid-template-columns: 110px 1fr; gap: 32px; align-items: center; padding: 22px 0; --esc: 92px; }
  .reino h3 { margin-bottom: 6px; }
  .reino p { max-width: 68ch; }
  .termino { display: block; font-family: var(--f-titulo); font-weight: 500; font-size: 25px; line-height: 1.15; }
  .conceptos { display: grid; grid-template-columns: 1fr 1fr; column-gap: 24px; border-top: 2px solid var(--line-strong); }
  .bloque > h2 + .conceptos { margin-top: 26px; }
  .conceptos > div { padding: 18px 24px 20px 0; border-bottom: 1px solid var(--linea); }
  .conceptos dd { max-width: 54ch; }
  .conceptos :global(.spoiler__contenido p) { margin-top: 2px; }
  .inframundo { display: grid; grid-template-columns: 5fr 7fr; gap: 40px 72px; }
  .inframundo dl { display: grid; gap: 26px; align-content: start; }
  .demonios li { border-top: 1px solid var(--linea); }
  .demonio { display: grid; grid-template-columns: 34px 1fr; gap: 18px; align-items: center; min-height: 72px; padding: 10px 0; text-decoration: none; transition: color 150ms var(--ease); }
  .demonio :global(.glifo) { width: 34px; height: 34px; color: var(--lacre-luz); }
  .demonio strong { display: block; font-family: var(--f-titulo); font-weight: 500; font-size: 25px; line-height: 1.1; }
  .demonio:hover strong { color: var(--oro); }
  @media (max-width: 900px) { .familias, .conceptos, .inframundo { grid-template-columns: 1fr; } .grimorios { grid-template-columns: 1fr; } .grimorios li { display: grid; grid-template-columns: 150px 1fr; grid-template-rows: auto 1fr; column-gap: 28px; } .grimorios :global(.grimorio) { grid-row: span 2; height: auto; width: 140px; margin: 0; } }
  @media (max-width: 639px) { .grimorios li { grid-template-columns: 96px 1fr; column-gap: 20px; } .grimorios :global(.grimorio) { width: 92px; } .reino { grid-template-columns: 72px 1fr; gap: 18px; --esc: 68px; align-items: start; } .familias dd { padding-left: 0; } }
</style>
