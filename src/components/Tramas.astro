---
/**
 * Tramas heráldicas (sistema Petra Sancta): los grabadores del siglo XVII marcaban cada color con un rayado.
 * Se definen una vez por página y las usan todos los escudos.
 */
---
<svg class="tramas" width="0" height="0" aria-hidden="true" focusable="false">
  <defs>
    <pattern id="t-oro" width="8" height="8" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="1.100" /><circle cx="6" cy="6" r="1.100" /></pattern>
    <pattern id="t-plata" width="14" height="14" patternUnits="userSpaceOnUse"><path d="M3 11l4-4M10 4l1-1" stroke-width="1" stroke="currentColor" /></pattern>
    <pattern id="t-gules" width="5" height="5" patternUnits="userSpaceOnUse"><path d="M2.500 0V5" stroke-width="1.100" stroke="currentColor" /></pattern>
    <pattern id="t-azur" width="5" height="5" patternUnits="userSpaceOnUse"><path d="M0 2.500H5" stroke-width="1.100" stroke="currentColor" /></pattern>
    <pattern id="t-sinople" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(-45)"><path d="M3 0V6" stroke-width="1.100" stroke="currentColor" /></pattern>
    <pattern id="t-purpura" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><path d="M3 0V6" stroke-width="1.100" stroke="currentColor" /></pattern>
    <pattern id="t-sable" width="5" height="5" patternUnits="userSpaceOnUse"><path d="M2.500 0V5M0 2.500H5" stroke-width=".9" stroke="currentColor" /></pattern>
    <pattern id="t-agua" width="14" height="7" patternUnits="userSpaceOnUse"><path d="M0 3.500q3.500-4 7 0t7 0" fill="none" stroke-width="1.100" stroke="currentColor" /></pattern>
    <pattern id="t-coral" width="7" height="14" patternUnits="userSpaceOnUse"><path d="M3.500 0q-4 3.500 0 7t0 7" fill="none" stroke-width="1.100" stroke="currentColor" /></pattern>
  </defs>
</svg>
<style>.tramas { position: absolute; color: #f1e4c6; fill: #f1e4c6; }</style>
