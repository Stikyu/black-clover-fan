---
/** Grimorio dibujado en SVG: tapa de cuero, guardas trenzadas, cantoneras y un trébol en el centro. */
import { azar, trazo, trenza, HOJA, angulos } from '@/lib/grabado';

interface Props { hojas?: 3 | 4 | 5; semilla?: number; clase?: string; titulo?: string }
const { hojas = 5, semilla = 7, clase = '', titulo } = Astro.props;
const r = azar(semilla * 97 + hojas);

const [a, b] = trenza(296, 6.5, 37);
const [c, d] = trenza(481, 6.5, 37);
// rayos del medallón
let rayos = '';
for (let i = 0; i < 120; i++) {
  const t = (i / 120) * Math.PI * 2;
  const r1 = 132 + r() * 4;
  const r2 = r1 + 14 + (i % 2 ? 9 : 0) + r() * 6;
  rayos += `M${(Math.cos(t) * r1).toFixed(1)} ${(Math.sin(t) * r1).toFixed(1)}L${(Math.cos(t) * r2).toFixed(1)} ${(Math.sin(t) * r2).toFixed(1)}`;
}
// grano del cuero
let grano = '';
for (let i = 0; i < 260; i++) {
  const x = 92 + r() * 356;
  const y = 40 + r() * 560;
  const l = 3 + r() * 9;
  grano += `M${x.toFixed(0)} ${y.toFixed(0)}l${(l * 0.8).toFixed(1)} ${(l * (r() - 0.2)).toFixed(1)}`;
}
// canto de las hojas
let canto = '';
for (let i = 0; i < 9; i++) canto += trazo(458 + i * 3, 34 + i * 2.2, 458 + i * 3, 616 + i * 3, r, 0.7, 6);
let cantoAbajo = '';
for (let i = 0; i < 8; i++) cantoAbajo += trazo(34 + i * 3, 622 + i * 3, 456 + i * 3, 622 + i * 3, r, 0.7, 6);
const escala = hojas === 5 ? 1.12 : hojas === 4 ? 1.14 : 1.2;
---
<svg class:list={['grimorio', clase]} viewBox="0 0 500 660" role={titulo ? 'img' : undefined} aria-label={titulo} aria-hidden={titulo ? undefined : 'true'}>
  <path class="g-hoja" d="M30 620 L54 646 H484 V58 L456 26Z" />
  <path class="g-linea g-linea--fina" d={canto + cantoAbajo} />
  <path class="g-tapa" d="M34 22 C150 18 340 24 454 20 C459 20 461 24 460 30 C457 220 462 420 459 614 C459 620 456 623 450 622 C320 618 170 625 36 621 C29 621 26 618 26 611 C30 420 24 220 27 31 C27 25 29 22 34 22Z" />
  <path class="g-linea g-linea--grano" d={grano} />
  {/* lomo con nervios */}
  <path class="g-linea" d="M76 22 C79 200 73 420 77 621" />
  <path class="g-linea g-linea--fina" d="M83 22 C86 200 80 420 84 621" />
  {[96, 206, 316, 426, 536].map((y) => (<><path class="g-nervio" d={`M27 ${y} C44 ${y - 5} 60 ${y - 4} 78 ${y} V${y + 17} C60 ${y + 13} 44 ${y + 13} 27 ${y + 17}Z`} /></>))}
  {/* guardas */}
  <rect class="g-linea" x="102" y="44" width="336" height="554" rx="3" fill="none" />
  <rect class="g-linea g-linea--fina" x="128" y="70" width="284" height="502" rx="2" fill="none" />
  <g class="g-trenza">
    <g transform="translate(122 57)"><path d={a} /><path d={b} /></g>
    <g transform="translate(122 585)"><path d={a} /><path d={b} /></g>
    <g transform="translate(115 80) rotate(90)"><path d={c} /><path d={d} /></g>
    <g transform="translate(425 80) rotate(90)"><path d={c} /><path d={d} /></g>
  </g>
  {/* cantoneras */}
  {[[440, 40, 0], [440, 602, 90], [100, 602, 180], [100, 40, 270]].map(([x, y, g]) => (
    <g transform={`translate(${x} ${y}) rotate(${g})`}>
      <path class="g-metal" d="M10 -12 H-66 C-60 4 -44 6 -38 -2 C-34 14 -20 16 -14 8 C-10 22 2 30 -6 38 C6 42 4 60 10 70Z" />
      <circle class="g-remache" cx="-6" cy="4" r="5" /><circle class="g-remache" cx="-46" cy="-5" r="3" /><circle class="g-remache" cx="4" cy="52" r="3" />
    </g>
  ))}
  {/* broches */}
  {[190, 430].map((y) => (
    <g transform={`translate(446 ${y})`}><path class="g-metal" d="M-22 -17 H26 C34 -10 34 24 26 32 H-22 C-14 20 -14 -6 -22 -17Z" /><circle class="g-remache" cx="12" cy="8" r="5" /></g>
  ))}
  {/* medallón */}
  <g transform="translate(270 321)">
    <path class="g-linea g-linea--fina" d={rayos} />
    <circle class="g-disco" r="128" />
    <circle class="g-linea" r="128" fill="none" />
    <circle class="g-linea g-linea--fina" r="121" fill="none" />
    <path class="g-tallo" d="M0 4 C6 40 -8 70 10 108" />
    <g transform={`translate(0 ${hojas === 5 ? 2 : 4}) scale(${escala})`}>
      {angulos(hojas).map((g, i) => (
        <g transform={`rotate(${g})`}>
          <path class:list={['g-trebol', hojas === 5 && i === 0 && 'g-trebol--demonio']} d={HOJA} />
          <path class="g-vena" d="M0-8L0-66M0-24L-14-40M0-24L14-40M0-42L-20-60M0-42L20-60" />
        </g>
      ))}
      <circle class="g-nudo" r="6" />
    </g>
  </g>
</svg>
<style>
  .grimorio { display: block; overflow: visible; }
  .g-hoja { fill: var(--g-papel); stroke: var(--g-trazo); stroke-width: 1.5; }
  .g-tapa { fill: var(--g-cuero); stroke: var(--g-trazo); stroke-width: 3; }
  .g-linea { stroke: var(--g-trazo); stroke-width: 1.8; fill: none; stroke-linecap: round; }
  .g-linea--fina { stroke-width: 0.9; opacity: 0.8; }
  .g-linea--grano { stroke-width: 0.7; opacity: 0.22; }
  .g-nervio { fill: var(--g-cuero-luz); stroke: var(--g-trazo); stroke-width: 1.4; }
  .g-trenza path { fill: none; stroke: var(--g-trazo); stroke-width: 2.2; }
  .g-metal { fill: var(--g-metal); stroke: var(--g-cuero); stroke-width: 1.5; }
  .g-remache { fill: var(--g-cuero); stroke: var(--g-trazo); stroke-width: 1; }
  .g-disco { fill: var(--g-fondo); }
  .g-trebol { fill: var(--g-verde); stroke: var(--g-trazo); stroke-width: 2; }
  .g-trebol--demonio { fill: var(--g-fondo); stroke: var(--g-verde-luz); }
  .g-vena { stroke: var(--g-verde-luz); stroke-width: 1.4; fill: none; stroke-linecap: round; }
  .g-tallo { stroke: var(--g-verde-luz); stroke-width: 5; fill: none; stroke-linecap: round; }
  .g-nudo { fill: var(--g-trazo); }
</style>
