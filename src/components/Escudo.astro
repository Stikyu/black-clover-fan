---
/** Escudo de armas: color y trama del escuadrón, con emblema o iniciales. */
import Glifo from './Glifo.astro';
interface Props { color: string; trama: string; emblema?: string; iniciales?: string; clase?: string }
const { color, trama, emblema, iniciales, clase = '' } = Astro.props;
---
<span class:list={['escudo', clase]} aria-hidden="true">
  <svg viewBox="0 0 100 120">
    <path d="M6 7C35 4 66 9 94 6C93 24 95 41 94 59C93 88 72 105 50 116C28 105 7 88 6 58C5 41 7 24 6 7Z" fill={color} />
    <path d="M6 7C35 4 66 9 94 6C93 24 95 41 94 59C93 88 72 105 50 116C28 105 7 88 6 58C5 41 7 24 6 7Z" fill={`url(#t-${trama})`} opacity=".26" />
    <path d="M12 13C38 10.500 64 14.500 88 12C87 28 89 42 88 58C87 83 69 98 50 108C31 98 13 83 12 58C11 42 13 28 12 13Z" fill="none" stroke="#f1e4c6" stroke-width="1.300" opacity=".7" />
    <path d="M6 7C35 4 66 9 94 6C93 24 95 41 94 59C93 88 72 105 50 116C28 105 7 88 6 58C5 41 7 24 6 7Z" fill="none" stroke="var(--oro)" stroke-width="3" />
  </svg>
  {emblema && <Glifo tipo={emblema} clase="escudo__glifo" />}
  {iniciales && <span class="escudo__ini">{iniciales}</span>}
</span>
<style>
  .escudo { position: relative; display: inline-grid; place-items: center; width: var(--esc, 88px); aspect-ratio: 100 / 120; }
  .escudo svg:first-child { position: absolute; inset: 0; width: 100%; height: 100%; }
  .escudo :global(.escudo__glifo) { position: relative; width: 54%; height: auto; color: #f7ecd2; stroke-width: 1.3; transform: translateY(-5%); }
  .escudo__ini { position: relative; font-family: var(--f-titulo); font-weight: 600; font-size: calc(var(--esc, 88px) * 0.42); line-height: 1; color: #f7ecd2; transform: translateY(-8%); letter-spacing: 0.01em; text-shadow: 0 1px 0 rgb(0 0 0 / 0.6), 0 0 8px rgb(0 0 0 / 0.35); }
</style>
